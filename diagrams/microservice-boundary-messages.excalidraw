      "link": null,
      "locked": false,
      "text": "Events are facts. They carry no address and are\nnot designed for any one consumer.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "5R62aqmeIeafFE2YHv9wA",
      "originalText": "Events are facts. They carry no address and are\nnot designed for any one consumer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aCFNkqGxOPC4cOnlGZt2k",
      "type": "text",
      "x": 790.2206878662109,
      "y": 453.75,
      "width": 379.5586242675781,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1c7ed6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 1965597326,
      "version": 3,
      "versionNonce": 26471310,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789992646466,
      "link": null,
      "locked": false,
      "text": "Commands ask for work. They stay inside the\nservice that owns the behaviour.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "EzgrBevZBAo33a-4JerPF",
      "originalText": "Commands ask for work. They stay inside the\nservice that owns the behaviour.",
      "autoResize": true,
      "lineHeight": 1.25
    }
