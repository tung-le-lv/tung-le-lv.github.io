    {
      "id": "UbWnaD0MY64rN_PSFh4U9",
      "type": "text",
      "x": 35.09068298339844,
      "y": 453.75,
      "width": 409.8186340332031,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#f59f00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 618779884,
      "version": 3,
      "versionNonce": 193639892,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789886819278,
      "link": null,
      "locked": false,
      "text": "Events are facts. They carry no address and are\nnot designed for any one consumer.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "hj_-Zi-nEXMpU_o3GgARn",
      "originalText": "Events are facts. They carry no address and are\nnot designed for any one consumer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DWjggvrfhY8Pvhu9_8Fer",
      "type": "text",
      "x": 790.2206878662109,
      "y": 453.75,
      "width": 379.5586242675781,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1c7ed6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1513117548,
      "version": 3,
      "versionNonce": 1342390636,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789886819278,
      "link": null,
      "locked": false,
      "text": "Commands ask for work. They stay inside the\nservice that owns the behaviour.",
      "fontSize": 17,
      "fontFamily": 5,
