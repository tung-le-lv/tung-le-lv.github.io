      "link": null,
      "locked": false,
      "text": "A duplicate message makes the INSERT fail\n(primary key violation), so the whole\ntransaction rolls back and the message is\ndiscarded.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QYOWpwKcy-JRaj4LZBWf4",
      "originalText": "A duplicate message makes the INSERT fail\n(primary key violation), so the whole\ntransaction rolls back and the message is discarded.",
      "autoResize": true,
      "lineHeight": 1.25
    }
