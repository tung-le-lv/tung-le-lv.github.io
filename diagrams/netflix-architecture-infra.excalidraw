    },
    {
      "id": "lHXiQ2IattiNT8ArSzOL2",
      "type": "text",
      "x": 355,
      "y": 1455,
      "width": 637.6314086914062,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04",
      "roundness": null,
      "seed": 1114506384,
      "version": 2,
      "versionNonce": 1491435120,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789993140529,
      "link": null,
      "locked": false,
      "text": "1   DNS: Route 53 resolves to the nearest healthy region\n2   TLS through WAF, ELB and Zuul; Zuul validates the device token (authN)\n3   authZ: membership and entitlements (plan, profile, region rights)\n4   Zuul routes to the GraphQL federated gateway, which composes the view\n5   gRPC fan-out to domain services (Eureka, client LB, ~800 ms deadline)\n6   Data reads: EVCache first, Cassandra on a miss; Hollow for catalog metadata\n7   The composed response returns to the device\n8   Press play: playback + steering return a DRM license and ranked OCA URLs\n9   Async: play and impression events go to Kafka; nobody waits\n10  Continuous: metrics, traces and logs flow to the observability stack",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1   DNS: Route 53 resolves to the nearest healthy region\n2   TLS through WAF, ELB and Zuul; Zuul validates the device token (authN)\n3   authZ: membership and entitlements (plan, profile, region rights)\n4   Zuul routes to the GraphQL federated gateway, which composes the view\n5   gRPC fan-out to domain services (Eureka, client LB, ~800 ms deadline)\n6   Data reads: EVCache first, Cassandra on a miss; Hollow for catalog metadata\n7   The composed response returns to the device\n8   Press play: playback + steering return a DRM license and ranked OCA URLs\n9   Async: play and impression events go to Kafka; nobody waits\n10  Continuous: metrics, traces and logs flow to the observability stack",
      "autoResize": true,
      "lineHeight": 1.25
    },
