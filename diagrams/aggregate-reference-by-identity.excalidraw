      "boundElements": null,
      "updated": 1794020845996,
      "link": null,
      "locked": false,
      "text": "A single transaction can easily change both.\nAn ORM can load Product just by following the field.\nNeither can move to another store on its own.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single transaction can easily change both.\nAn ORM can load Product just by following the field.\nNeither can move to another store on its own.",
      "autoResize": true,
      "lineHeight": 1.25
    },
