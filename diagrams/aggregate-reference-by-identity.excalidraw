      "isDeleted": false,
      "boundElements": null,
      "updated": 1794020845996,
      "link": null,
      "locked": false,
      "text": "There is nothing to navigate, so the second Aggregate\ntakes a deliberate repository call to reach.\nEach loads, and can be partitioned, on its own.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There is nothing to navigate, so the second Aggregate\ntakes a deliberate repository call to reach.\nEach loads, and can be partitioned, on its own.",
      "autoResize": true,
      "lineHeight": 1.25
    },
