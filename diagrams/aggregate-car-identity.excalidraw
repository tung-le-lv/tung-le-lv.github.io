      "isDeleted": false,
      "boundElements": null,
      "updated": 1794020845789,
      "link": null,
      "locked": false,
      "text": "Its own root only because this\nbusiness tracks engines across\nseveral cars.\n\nWhere nobody does that, an engine\ncan stay inside the Car.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its own root only because this\nbusiness tracks engines across\nseveral cars.\n\nWhere nobody does that, an engine\ncan stay inside the Car.",
      "autoResize": true,
      "lineHeight": 1.25
    },
