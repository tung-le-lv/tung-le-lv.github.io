      "updated": 1794020845789,
      "link": null,
      "locked": false,
      "text": "Local identity: \"front left\" only means something inside this car.\nNobody looks up a tire on its own, so there is no TireRepository.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Local identity: \"front left\" only means something inside this car.\nNobody looks up a tire on its own, so there is no TireRepository.",
      "autoResize": true,
      "lineHeight": 1.25
    },
